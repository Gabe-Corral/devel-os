# Maintainer: DevelOS

pkgname=develos-live-config
pkgver=0.1.0
pkgrel=1
pkgdesc="Live ISO configuration for DevelOS"
arch=('any')
url="https://github.com/gabe-corral/devel-os"
license=('MIT')
optdepends=(
    'develos-config: shared desktop and user defaults'
    'systemd: live ISO services'
)
source=("${pkgname}-${pkgver}.tar.gz")
install=develos-live-config.install
sha256sums=('SKIP')

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cp -a . "${pkgdir}/"

    chmod 440 "${pkgdir}/etc/sudoers.d/devel"
    chmod 755 "${pkgdir}/usr/local/bin/choose-mirror"
    chmod 755 "${pkgdir}/usr/local/bin/develos-install-gui"
    chmod 755 "${pkgdir}/usr/local/bin/develos-live-install-notification"
    chmod 755 "${pkgdir}/usr/local/bin/Installation_guide"
    chmod 755 "${pkgdir}/usr/local/bin/livecd-sound"
    chmod 755 "${pkgdir}/usr/local/bin/start-dwm-live"
}
