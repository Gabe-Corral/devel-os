#!/usr/bin/env python3
import os
import getpass
import re
import shlex
import subprocess
import time
from pathlib import Path


MOUNT = Path("/mnt")
PACKAGES_FILE = Path("/usr/share/develos/packages.installed.x86_64")
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]*$")
HOSTNAME_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$")


def run(cmd, check=True, **kwargs):
    subprocess.run(cmd, check=check, **kwargs)


def require_root():
    if os.geteuid() != 0:
        raise SystemExit("You must run the installer as root.")


def gather_info():
    info = {}

    info["disk"] = input("DISK: ").strip()
    info["hostname"] = input("HOSTNAME: ").strip()
    info["username"] = input("USERNAME: ").strip()
    info["timezone"] = input("TIMEZONE [America/Chicago]: ").strip() or "America/Chicago"

    if not info["disk"]:
        raise SystemExit("Disk is required.")

    if not info["hostname"]:
        raise SystemExit("Hostname is required.")

    if not info["username"]:
        raise SystemExit("Username is required.")

    if not Path(info["disk"]).exists():
        raise SystemExit(f"Disk does not exist: {info['disk']}")

    if not USERNAME_RE.match(info["username"]):
        raise SystemExit("Username must start with a lowercase letter or underscore and contain only lowercase letters, numbers, underscores, and hyphens.")

    if not HOSTNAME_RE.match(info["hostname"]):
        raise SystemExit("Hostname must contain only letters, numbers, and hyphens, and must not start with a hyphen.")

    timezone_path = Path("/usr/share/zoneinfo") / info["timezone"]

    if info["timezone"].startswith("/") or ".." in Path(info["timezone"]).parts or not timezone_path.exists():
        raise SystemExit(f"Timezone does not exist: {info['timezone']}")

    return info


def confirm_install(info):
    print("\nWARNING: This will erase the selected disk.\n")
    print(f"Disk:     {info['disk']}")
    print(f"Hostname: {info['hostname']}")
    print(f"Username: {info['username']}")
    print(f"Timezone: {info['timezone']}")

    confirm = input("Type INSTALL to continue: ").strip()

    if confirm != "INSTALL":
        raise SystemExit("Install cancelled.")


def part(disk, number):
    if disk[-1].isdigit():
        return f"{disk}p{number}"

    return f"{disk}{number}"


def partition_disk(info):
    disk = info["disk"]

    run(["parted", "-s", disk, "mklabel", "gpt"])
    run(["parted", "-s", disk, "mkpart", "ESP", "fat32", "1MiB", "513MiB"])
    run(["parted", "-s", disk, "set", "1", "esp", "on"])
    run(["parted", "-s", disk, "mkpart", "primary", "ext4", "513MiB", "100%"])
    run(["partprobe", disk], check=False)
    run(["udevadm", "settle"])


def wait_for_partitions(info):
    efi = Path(part(info["disk"], 1))
    root = Path(part(info["disk"], 2))

    for _ in range(20):
        if efi.exists() and root.exists():
            return

        time.sleep(0.25)

    raise SystemExit(f"Partition devices did not appear: {efi}, {root}")


def format_partitions(info):
    efi = part(info["disk"], 1)
    root = part(info["disk"], 2)

    run(["mkfs.fat", "-F32", efi])
    run(["mkfs.ext4", "-F", root])


def mount_partitions(info):
    efi = part(info["disk"], 1)
    root = part(info["disk"], 2)

    run(["mount", root, str(MOUNT)])
    (MOUNT / "boot/efi").mkdir(parents=True, exist_ok=True)
    run(["mount", efi, str(MOUNT / "boot/efi")])


def read_package_manifest():
    if not PACKAGES_FILE.exists():
        raise SystemExit(f"Package manifest not found: {PACKAGES_FILE}")

    packages = []

    for line in PACKAGES_FILE.read_text().splitlines():
        package = line.strip()

        if package and not package.startswith("#"):
            packages.append(package)

    return packages


def install_base():
    packages = read_package_manifest()

    run(["pacstrap", "-K", "-C", "/etc/pacman.conf", str(MOUNT), *packages])

    with open(MOUNT / "etc/fstab", "a") as f:
        subprocess.run(["genfstab", "-U", str(MOUNT)], stdout=f, check=True)


def install_ly(info):
    username = info["username"]
    config_src = Path("/etc/ly/config.ini")
    config_dst = MOUNT / "etc/ly/config.ini"

    if config_src.exists():
        config_dst.parent.mkdir(parents=True, exist_ok=True)
        config = config_src.read_text()
        config = config.replace("auto_login_user = devel", f"auto_login_user = {username}")
        config_dst.write_text(config)


def install_develos_repo():
    src = Path("/opt/develos/repo")
    dst = MOUNT / "opt/develos/repo"

    if src.exists():
        dst.parent.mkdir(parents=True, exist_ok=True)
        run(["cp", "-a", str(src), str(dst.parent)])

    pacman_conf_src = Path("/etc/pacman.conf")
    pacman_conf_dst = MOUNT / "etc/pacman.conf"

    if pacman_conf_src.exists():
        run(["cp", "-a", str(pacman_conf_src), str(pacman_conf_dst)])


def run_chroot(script):
    subprocess.run(
        ["arch-chroot", str(MOUNT), "/bin/bash"],
        input=script,
        text=True,
        check=True,
    )


def configure_system(info):
    hostname = info["hostname"]
    username = info["username"]
    timezone = info["timezone"]
    hostname_q = shlex.quote(hostname)
    timezone_path_q = shlex.quote(f"/usr/share/zoneinfo/{timezone}")
    username_q = shlex.quote(username)
    home_q = shlex.quote(f"/home/{username}")
    user_group_q = shlex.quote(f"{username}:{username}")

    script = f"""
set -e

ln -sf {timezone_path_q} /etc/localtime
hwclock --systohc

sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen

echo "LANG=en_US.UTF-8" > /etc/locale.conf
echo {hostname_q} > /etc/hostname

cat > /etc/hosts <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 {hostname}.localdomain {hostname}
EOF

useradd -m -G wheel -s /bin/bash {username_q}

# copy default dotfiles and other skel content into the new user's home
cp -a /etc/skel/. {home_q}/
chown -R {user_group_q} {home_q}

echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel

systemctl enable NetworkManager
systemctl enable ly@tty1.service

if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="DevelOS"/' /etc/default/grub
else
    echo 'GRUB_DISTRIBUTOR="DevelOS"' >> /etc/default/grub
fi

grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=DevelOS --no-nvram --recheck
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=DevelOS --removable --no-nvram --recheck
grub-mkconfig -o /boot/grub/grub.cfg
test -s /boot/grub/grub.cfg

root_uuid="$(findmnt -no UUID /)"
if [ -z "$root_uuid" ]; then
    echo "ERROR: unable to determine root filesystem UUID." >&2
    exit 1
fi

mkdir -p /boot/efi/EFI/DevelOS /boot/efi/EFI/BOOT
for grub_efi_cfg in /boot/efi/EFI/DevelOS/grub.cfg /boot/efi/EFI/BOOT/grub.cfg; do
    cat > "$grub_efi_cfg" <<EOF
search --no-floppy --fs-uuid --set=root $root_uuid
set prefix=(\\$root)/boot/grub
configfile /boot/grub/grub.cfg
EOF
done
"""

    run_chroot(script)


def set_passwords(info):
    username = info["username"]
    root_password = prompt_password("ROOT")
    user_password = prompt_password(username)

    run(
        ["arch-chroot", str(MOUNT), "chpasswd"],
        input=f"root:{root_password}\n",
        text=True,
    )

    run(
        ["arch-chroot", str(MOUNT), "chpasswd"],
        input=f"{username}:{user_password}\n",
        text=True,
    )

    run(["arch-chroot", str(MOUNT), "passwd", "-S", "root"])
    run(["arch-chroot", str(MOUNT), "passwd", "-S", username])


def prompt_password(label):
    while True:
        password = getpass.getpass(f"\nSet password for {label}: ")
        confirm = getpass.getpass(f"Confirm password for {label}: ")

        if not password:
            print("Password cannot be empty.")
            continue

        if password != confirm:
            print("Passwords do not match.")
            continue

        return password

    # chpasswd_input = f"{username}:password"
    # command = ["arch-chroot", str(MOUNT), "chpasswd"]

    # try:
    #     subprocess.run(
    #         command,
    #         input=chpasswd_input,
    #         text=True,
    #         check=True
    #     )
    #     print(f"Password for user '{username}' set successfully.")
    # except subprocess.CalledProcessError as e:
    #     print(f"Failed to set password: {e}")


def main():
    require_root()

    info = gather_info()
    confirm_install(info)

    run(["timedatectl", "set-ntp", "true"])

    partition_disk(info)
    wait_for_partitions(info)
    format_partitions(info)
    mount_partitions(info)
    install_base()
    install_ly(info)
    install_develos_repo()
    configure_system(info)
    set_passwords(info)

    print("\nInstall complete. You can now reboot.")


if __name__ == "__main__":
    main()
