# Maintainer: DevelOS

pkgname=develos-dmenu
pkgver=5.4
pkgrel=1
pkgdesc="DevelOS build of dmenu"
arch=('x86_64')
url="https://tools.suckless.org/dmenu/"
license=('MIT')
depends=('fontconfig' 'freetype2' 'libx11' 'libxft' 'libxinerama')
provides=('dmenu')
conflicts=('dmenu')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make clean
    make PREFIX=/usr
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make PREFIX=/usr DESTDIR="${pkgdir}" install
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
